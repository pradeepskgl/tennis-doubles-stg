# MongoDB Atlas connection string (use a DIFFERENT database/cluster than the singles app)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ao_doubles_tournament?retryWrites=true&w=majority

# Port the app listens on
PORT=3001

# Secret used to sign admin session cookies (set to a long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# How long an admin session stays valid, in hours
SESSION_HOURS=12

# How long a soft edit-lock on a match stays valid before it expires, in seconds
LOCK_TTL_SECONDS=90
